<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gonet.primary.member.mapper.MemberPasswordHistoryMapper">

  <sql id="filter">
    <where>
      <if test="search.memberId != null and search.memberId != ''">
        AND member_id = #{search.memberId}
      </if>
      <if test="search.changedFrom != null">
        AND changed_at &gt;= #{search.changedFrom}
      </if>
      <if test="search.changedTo != null">
        AND changed_at &lt; #{search.changedTo}
      </if>
    </where>
  </sql>

  <sql id="cols">
    pwd_history_id, member_id, password_hash, changed_at,
    created_by, created_ip, created_at,
    updated_by, updated_ip, updated_at
  </sql>

  <select id="findList" resultType="com.gonet.primary.member.dto.MemberPasswordHistory">
    SELECT <include refid="cols"/>
      FROM tb_member_password_history
    <include refid="filter"/>
     ORDER BY changed_at DESC
     LIMIT #{search.pageSize} OFFSET #{search.offset}
  </select>

  <select id="countList" resultType="int">
    SELECT COUNT(*) FROM tb_member_password_history
    <include refid="filter"/>
  </select>

  <select id="findById" resultType="com.gonet.primary.member.dto.MemberPasswordHistory">
    SELECT <include refid="cols"/>
      FROM tb_member_password_history
     WHERE pwd_history_id = #{pwdHistoryId}
  </select>

  <select id="findForExport" resultType="com.gonet.primary.member.dto.MemberPasswordHistory">
    SELECT <include refid="cols"/>
      FROM tb_member_password_history
    <include refid="filter"/>
     ORDER BY changed_at DESC
     LIMIT 50000
  </select>

</mapper>
