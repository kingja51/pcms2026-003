# ═══════════════════════════════════════════════════════════════════════
#  PCMS 2026-003 — 환경변수 전체 템플릿 (git 추적 대상)
# ═══════════════════════════════════════════════════════════════════════
#
#  ★ 이 파일은 템플릿이다. .env 사본이 아니다.
#    비밀값은 전부 __CHANGE_ME__ 로 두고, 비밀이 아닌 값(경로·드라이버·
#    localhost URL·토글)만 예시값을 적는다.
#    001 에서 .env.example 이 .env 사본이라 운영 비밀값 21종이 커밋 직전까지
#    갔던 이력이 있다. 이 파일에 실제 비밀값을 적지 않는다.
#
#  사용법
#    cp .env.example .env    후 __CHANGE_ME__ 를 채운다.
#    키(비밀·연동키)의 용도·발급처·사용처는 .env.key.example 에 정리돼 있다.
#
#  역할 분담
#    .env.example     ← 이 파일. 전체 환경변수. 커밋한다.
#    .env             ← 실제 주입값 전체. git 제외.
#    .env.key.example ← 키 인벤토리(용도·발급처·페이즈). 커밋한다.
#    .env.key         ← 키 실제 값. git 제외.
#
#  원칙
#    - yml 에 비밀값 기본값을 박지 않는다. 기본값 없는 ${VAR} 로만 주입한다.
#    - 미주입 시 부팅 실패(fail-fast)는 의도된 동작이다.
#    - 커밋 전 git status 로 .env / .env.key 스테이징 여부를 확인한다.
# ═══════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────
#  1. 프로젝트 식별
# ───────────────────────────────────────────────────────────────────────
PCMS_PROJECT_NAME_KO=(주)지오넷 PCMS 2026
PCMS_PROJECT_NAME_EN=PCMS2026


# ───────────────────────────────────────────────────────────────────────
#  2. 데이터베이스 — 3-DB 분리
#     D4 결정(2026-07-31): 001 과 분리. MariaDB 11.8.3.
#     DB 명에 하이픈이 있다 — SQL 에서는 백틱이 필요하다(JDBC URL 은 무관).
#     비밀번호는 .env.key 로 관리한다.
# ───────────────────────────────────────────────────────────────────────

# primary — tb_* 업무 테이블
PCMS_DB_PRIMARY_DRIVER=org.mariadb.jdbc.Driver
PCMS_DB_PRIMARY_URL=jdbc:mariadb://localhost:3306/pcms2026-003-primary?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useSSL=false
PCMS_DB_PRIMARY_USER=__CHANGE_ME__
PCMS_DB_PRIMARY_PASSWORD=__CHANGE_ME__

# secondary — 개별프로그램·외부 API 수집
PCMS_DB_SECONDARY_DRIVER=org.mariadb.jdbc.Driver
PCMS_DB_SECONDARY_URL=jdbc:mariadb://localhost:3306/pcms2026-003-secondary?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useSSL=false
PCMS_DB_SECONDARY_USER=__CHANGE_ME__
PCMS_DB_SECONDARY_PASSWORD=__CHANGE_ME__

# logging — log_*·stat_*·shedlock
PCMS_DB_LOGGING_DRIVER=org.mariadb.jdbc.Driver
PCMS_DB_LOGGING_URL=jdbc:mariadb://localhost:3306/pcms2026-003-logging?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useSSL=false
PCMS_DB_LOGGING_USER=__CHANGE_ME__
PCMS_DB_LOGGING_PASSWORD=__CHANGE_ME__


# ───────────────────────────────────────────────────────────────────────
#  3. 파일 경로
#     운영에서는 웹루트 밖에 둔다. 업로드 6중 방어의 격리 경로가 여기 의존.
#     Windows 로컬 예시 — 운영(Linux)에서는 /data/pcms2026-003/… 형태
# ───────────────────────────────────────────────────────────────────────
PCMS_UPLOAD_ROOT=D:/data/pcms2026-003/uploads
PCMS_QUARANTINE=D:/data/pcms2026-003/quarantine
PCMS_THUMBNAIL=D:/data/pcms2026-003/thumbnail
PCMS_PREVIEW_CACHE=D:/data/pcms2026-003/preview-cache
PCMS_STATIC_ROOT=D:/data/pcms2026-003/static

# 문서 미리보기 변환용. 미설치면 미리보기만 비활성(기동에는 영향 없음)
PCMS_LIBREOFFICE_HOME=C:/Program Files/LibreOffice


# ───────────────────────────────────────────────────────────────────────
#  4. 네트워크 · 프록시
# ───────────────────────────────────────────────────────────────────────

# 신뢰 프록시 CIDR 목록(쉼표 구분). 비우면 XFF 를 신뢰하지 않는다.
# IpUtils 가 XFF 를 우측부터 스캔할 때 이 목록을 기준으로 판단한다 —
# 잘못 넣으면 클라이언트가 IP 를 위조할 수 있다. 리버스 프록시 뒤일 때만 채운다.
PCMS_TRUSTED_PROXIES=


# ───────────────────────────────────────────────────────────────────────
#  5. 개인정보 암호화 (P1)  — 상세는 .env.key.example §1
# ───────────────────────────────────────────────────────────────────────
#     master-key(AES-256-GCM 암호화) 와 hmac-key(*_hash 산출) 는 반드시 다른 값을 쓴다.
#     둘 다 base64 32바이트 — 생성: openssl rand -base64 32
PCMS_PII_MASTER_KEY=__CHANGE_ME__
PCMS_PII_HMAC_KEY=__CHANGE_ME__
PCMS_PII_KEY_ID=__CHANGE_ME__
JASYPT_ENCRYPTOR_PASSWORD=__CHANGE_ME__


# ───────────────────────────────────────────────────────────────────────
#  6. 소셜 로그인 OAuth2 (P5)  — 상세는 .env.key.example §3
#     로컬에서 콜백을 받으려면 외부 노출 URL 이 필요하다(ngrok 등).
#     콜백 URL 은 각 개발자센터에 등록한 값과 정확히 일치해야 한다.
# ───────────────────────────────────────────────────────────────────────
PCMS_OAUTH2_REDIRECT_BASE_URL=http://localhost:8080

PCMS_OAUTH2_NAVER_ENABLED=false
PCMS_OAUTH2_NAVER_CLIENT_ID=__CHANGE_ME__
PCMS_OAUTH2_NAVER_CLIENT_SECRET=__CHANGE_ME__
PCMS_OAUTH2_NAVER_CALLBACK_URL=http://localhost:8080/member/oauth2/naver/callback

PCMS_OAUTH2_KAKAO_ENABLED=false
PCMS_OAUTH2_KAKAO_CLIENT_ID=__CHANGE_ME__
PCMS_OAUTH2_KAKAO_CLIENT_SECRET=__CHANGE_ME__
PCMS_OAUTH2_KAKAO_CALLBACK_URL=http://localhost:8080/member/oauth2/kakao/callback

PCMS_OAUTH2_GOOGLE_ENABLED=false
PCMS_OAUTH2_GOOGLE_CLIENT_ID=__CHANGE_ME__
PCMS_OAUTH2_GOOGLE_CLIENT_SECRET=__CHANGE_ME__
PCMS_OAUTH2_GOOGLE_CALLBACK_URL=http://localhost:8080/member/oauth2/google/callback


# ───────────────────────────────────────────────────────────────────────
#  7. NICE 본인인증 (P5)  — 상세는 .env.key.example §4
#     NiceID jar 는 JPMS 플래그가 필요하다. 누락 시 본인인증에서만 500.
# ───────────────────────────────────────────────────────────────────────
PCMS_NICE_SITE_CODE=__CHANGE_ME__
PCMS_NICE_SITE_PASSWORD=__CHANGE_ME__
PCMS_NICE_RETURN_URL=http://localhost:8080/member/identity/nice/success
PCMS_NICE_ERROR_URL=http://localhost:8080/member/identity/nice/fail


# ───────────────────────────────────────────────────────────────────────
#  8. 캡차 (P2)  — 상세는 .env.key.example §5
# ───────────────────────────────────────────────────────────────────────
PCMS_CAPTCHA_ENABLED=false
PCMS_CAPTCHA_SITE_KEY=__CHANGE_ME__
PCMS_CAPTCHA_SECRET_KEY=__CHANGE_ME__


# ───────────────────────────────────────────────────────────────────────
#  9. 메일 발송 (P6)  — 상세는 .env.key.example §6
#     휴면 해제 이메일 OTP(§10-6)가 여기에 의존한다.
#     Gmail 은 계정 비밀번호가 아니라 앱 비밀번호(16자리)를 쓴다.
# ───────────────────────────────────────────────────────────────────────
#     발신 계정 주소는 001 이 yml 에 하드코딩했으나 003 은 환경변수로 뺐다.
PCMS_MAIL_HOST=smtp.gmail.com
PCMS_MAIL_PORT=587
PCMS_MAIL_USERNAME=__CHANGE_ME__
GMAIL_SMTP_USER_PASSWD=__CHANGE_ME__


# ───────────────────────────────────────────────────────────────────────
#  10. 지도 · 공공 API (P6)  — 상세는 .env.key.example §7
# ───────────────────────────────────────────────────────────────────────
PCMS_KAKAO_MAP_APPKEY=__CHANGE_ME__
PCMS_NAVER_MAP_CLIENT_ID=__CHANGE_ME__
PCMS_GOOGLE_MAP_API_KEY=__CHANGE_ME__
PCMS_KMA_SERVICE_KEY=__CHANGE_ME__


# ───────────────────────────────────────────────────────────────────────
#  11. 검색 — 해당 없음
#     D10 결정(2026-07-31): 외부 검색엔진을 contextPath=/search 로 붙인다.
#     앱은 색인·검색어 수집을 하지 않으므로 관련 환경변수가 없다.
# ───────────────────────────────────────────────────────────────────────


# ───────────────────────────────────────────────────────────────────────
#  12. 운영 알림 (P7)  — 상세는 .env.key.example §8
# ───────────────────────────────────────────────────────────────────────
PCMS_ALERT_TELEGRAM_ENABLED=false
PCMS_ALERT_TELEGRAM_BOT_TOKEN=__CHANGE_ME__
PCMS_ALERT_TELEGRAM_CHAT_ID=__CHANGE_ME__


# ───────────────────────────────────────────────────────────────────────
#  13. Flyway · 로컬 경로 (P0)
#     PCMS_FLYWAY_ENABLED — 마이그레이션 실행 토글 (D1 ③ 확정 2026-07-31).
#     local·dev 는 앱이 실행(기본 true), 운영은 DBA 가 Flyway CLI 로 집행한다.
#     prod 는 이 환경변수를 아예 읽지 않는다 — application-prod.yml 에 false 고정.
# ───────────────────────────────────────────────────────────────────────
PCMS_FLYWAY_ENABLED=true
PCMS_CONTENT_HTML_ROOT=D:/data/pcms2026-003/content-templates
