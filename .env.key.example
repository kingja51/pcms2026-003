# ═══════════════════════════════════════════════════════════════════════
#  PCMS 2026-003 — 키 인벤토리 (템플릿 · git 추적 대상)
# ═══════════════════════════════════════════════════════════════════════
#
#  ★ 이 파일에는 실제 값을 절대 적지 않는다. 전부 __CHANGE_ME__ 로 둔다.
#    실제 값은 이 파일을 .env.key 로 복사한 뒤 거기에 채운다(git 제외됨).
#    001 에서 .env.example 이 .env 사본이 되어 비밀값 21종이
#    커밋 직전까지 갔던 사고가 있었다. 같은 실수를 반복하지 않는다.
#
#  역할 분담
#    .env.key.example ← 이 파일. 키 목록·용도·사용처. 커밋한다.
#    .env.key         ← 위를 복사해 실제 키 값을 채운 것. git 제외.
#    .env.example     ← 전체 환경변수 템플릿(경로·URL·토글 포함). 커밋한다.
#    .env             ← 실제 주입값 전체. git 제외.
#
#  표기
#    [S] 비밀   — 유출 시 즉시 폐기·재발급. 절대 커밋·로그·화면 노출 금지
#    [P] 공개   — 클라이언트에 노출되는 것이 전제. 도메인·리퍼러 제한으로 방어
#    (P0)…(P7)  — PLAN 상 이 키가 실제로 필요해지는 페이즈
#
#  규칙
#    1. 키를 추가·폐기하면 이 파일을 먼저 고치고, 그 다음 .env.key 에 반영한다.
#    2. yml 에 기본값을 박지 않는다 — 기본값 없는 ${VAR} 로만 주입한다.
#    3. 값이 필요 없어진 키는 지우지 말고 "폐기" 로 표시하고 사유·일자를 남긴다.
#       (001 에서 뭘 쓰는지 몰라 방치된 키가 쌓인 것이 이 파일을 만든 이유다)
#
#  출처: 001 실측(application*.yml 참조 변수 57종에서 키만 분류)
# ═══════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────
#  1. 개인정보 암호화 — 최우선
# ───────────────────────────────────────────────────────────────────────

# [S] (P1) PII AES-256-GCM 암호화 키
#   용도 : @Encrypt 필드 암복호. 저장값은 {AG} 프리픽스가 붙는다
#   사용 : common/crypto/AesGcmCipher · config/interceptor/EncryptInterceptor
#   생성 : openssl rand -base64 32
#   주의 : 미설정 시 부팅 실패(fail-fast) — 의도된 동작이다
#   분실 : 복구 불가. 암호화된 PII 전량을 읽을 수 없게 된다. 별도 보관 필수
PCMS_PII_MASTER_KEY=__CHANGE_ME__

# [S] (P1) PII HMAC-SHA256 키 — *_hash 컬럼 전용
#   용도 : 완전일치 검색·중복확인용 해시 산출
#          email_hash · login_id_hash · di_hash · parent_di_hash ·
#          voter_name_hash · birth_date_hash · resident_no_suffix_hash
#   사용 : common/crypto/EmailHasher
#   생성 : openssl rand -base64 32
#   주의 : MASTER_KEY 와 **반드시 다른 값**을 쓴다(key separation, 2026-07-31 결정).
#          001 은 MASTER_KEY 를 재사용했으나 003 은 분리한다
#   회전 : MASTER_KEY 보다 비싸다. 해시는 단방향이라 원문을 다시 얻어야 하므로
#          MASTER_KEY 로 복호화 → 새 HMAC_KEY 로 재해시가 필요하고,
#          그동안 로그인·중복확인이 깨진다. 점검 시간에 일괄 수행할 것
PCMS_PII_HMAC_KEY=__CHANGE_ME__

# [P] (P1) PII 키 세대 식별자
#   용도 : 마스터키 로테이션 시 어느 세대로 암호화됐는지 구분
#   교체 : 새 키 발급 → KEY_ID 증가 → 재암호화 배치 → 구 키 폐기
PCMS_PII_KEY_ID=__CHANGE_ME__

# [S] (P0) Jasypt 설정값 암호화 비밀번호
#   용도 : yml 내 ENC(...) 항목 복호화
#   주의 : 이 키 하나가 뚫리면 yml 암호화 전체가 무의미해진다
JASYPT_ENCRYPTOR_PASSWORD=__CHANGE_ME__


# ───────────────────────────────────────────────────────────────────────
#  2. 데이터베이스 — 3-DB 분리 (비밀번호만. URL·USER 는 .env.example)
# ───────────────────────────────────────────────────────────────────────

# [S] (P0) primary DB — tb_* 업무 테이블
PCMS_DB_PRIMARY_PASSWORD=__CHANGE_ME__

# [S] (P0) secondary DB — 개별프로그램·외부 API 수집
PCMS_DB_SECONDARY_PASSWORD=__CHANGE_ME__

# [S] (P0) logging DB — log_*·stat_*·shedlock
PCMS_DB_LOGGING_PASSWORD=__CHANGE_ME__


# ───────────────────────────────────────────────────────────────────────
#  3. 소셜 로그인 OAuth2 (P5)
#     CLIENT_ID 는 공개, CLIENT_SECRET 은 비밀. 콜백 URL 은 .env.example
# ───────────────────────────────────────────────────────────────────────

# 네이버 — https://developers.naver.com
PCMS_OAUTH2_NAVER_CLIENT_ID=__CHANGE_ME__        # [P]
PCMS_OAUTH2_NAVER_CLIENT_SECRET=__CHANGE_ME__    # [S]

# 카카오 — https://developers.kakao.com
PCMS_OAUTH2_KAKAO_CLIENT_ID=__CHANGE_ME__        # [P]
PCMS_OAUTH2_KAKAO_CLIENT_SECRET=__CHANGE_ME__    # [S]

# 구글 — https://console.cloud.google.com/apis/credentials
PCMS_OAUTH2_GOOGLE_CLIENT_ID=__CHANGE_ME__       # [P]
PCMS_OAUTH2_GOOGLE_CLIENT_SECRET=__CHANGE_ME__   # [S]


# ───────────────────────────────────────────────────────────────────────
#  4. NICE 본인인증 (P5)
# ───────────────────────────────────────────────────────────────────────

# [P] NICE 사이트코드
PCMS_NICE_SITE_CODE=__CHANGE_ME__

# [S] NICE 사이트 비밀번호
#   사용 : primary/identity · NiceCheckService
#   주의 : NiceID jar 는 JPMS 플래그가 필요하다(--add-exports/--add-opens
#          java.base/com.sun.crypto.provider=ALL-UNNAMED).
#          surefire · spring-boot:run · 운영 setenv 모두에 넣어야 하고,
#          빠뜨리면 본인인증 화면에서만 500 이 난다
PCMS_NICE_SITE_PASSWORD=__CHANGE_ME__


# ───────────────────────────────────────────────────────────────────────
#  5. 캡차 (P2)
# ───────────────────────────────────────────────────────────────────────

# [P] 클라이언트 위젯용 사이트 키 — HTML 에 노출된다
PCMS_CAPTCHA_SITE_KEY=__CHANGE_ME__

# [S] 서버 검증용 시크릿 — 절대 클라이언트로 내려보내지 않는다
PCMS_CAPTCHA_SECRET_KEY=__CHANGE_ME__


# ───────────────────────────────────────────────────────────────────────
#  6. 메일 발송 (P6)
#     휴면 해제 이메일 OTP(§10-6)·알림 메일이 여기에 의존한다
# ───────────────────────────────────────────────────────────────────────

# [S] SMTP 발송 계정 비밀번호
#   Gmail 사용 시 계정 비밀번호가 아니라 앱 비밀번호(16자리)를 쓴다
#   사용 : common/mail/MailService · tb_mail_template
GMAIL_SMTP_USER_PASSWD=__CHANGE_ME__


# ───────────────────────────────────────────────────────────────────────
#  7. 지도 / 공공 API — secondary DB 연동 (P6)
# ───────────────────────────────────────────────────────────────────────

# [P] 카카오 지도 JavaScript 앱키 — 도메인 제한을 반드시 건다
PCMS_KAKAO_MAP_APPKEY=__CHANGE_ME__

# [P] 네이버 지도 Client ID — 웹서비스 URL 제한을 건다
PCMS_NAVER_MAP_CLIENT_ID=__CHANGE_ME__

# [S] 구글 지도 API 키
#   주의 : 제한 없이 두면 과금 남용 대상이 된다. HTTP 리퍼러 + API 제한 필수
PCMS_GOOGLE_MAP_API_KEY=__CHANGE_ME__


# [S] 기상청(KMA) 서비스 키 — data.go.kr
#   사용 : secondary — tb_api_weather
PCMS_KMA_SERVICE_KEY=__CHANGE_ME__


# ───────────────────────────────────────────────────────────────────────
#  8. 운영 알림 (P7)
# ───────────────────────────────────────────────────────────────────────

# [S] 텔레그램 봇 토큰 — 배치 실패·보안 이벤트 알림
#   토글 PCMS_ALERT_TELEGRAM_ENABLED 는 .env.example 에 있다
PCMS_ALERT_TELEGRAM_BOT_TOKEN=__CHANGE_ME__

# [P] 수신 채팅방 ID
PCMS_ALERT_TELEGRAM_CHAT_ID=__CHANGE_ME__


# ───────────────────────────────────────────────────────────────────────
#  9. 001 에 있었으나 003 은 반입하지 않는 키 (2026-07-31 확정)
# ───────────────────────────────────────────────────────────────────────
#
#  GEMINI_API_KEY      — Google GenAI Java SDK 미도입. AI 기능은 추후 context
#                        방식으로 별도 개발한다. tb_search_gemini_* 2종도 삭제됨.
#  PCMS_G2B_SERVICE_KEY— 조달청 나라장터 OpenAPI 미이식. tb_g2b_* 4종
#                        (bid_notice / order_plan / opening_result / collect_log) 삭제.
#  PCMS_SEARCH_STOPWORDS_ENABLED
#                      — 검색은 외부 검색엔진(contextPath=/search) 으로 분리(D10).
#                        앱은 색인·검색어 수집을 하지 않는다.
#
#  ▶ 위 기능을 나중에 도입하면 이 절에서 해당 항목을 지우고 본문 절로 옮긴다.


# ═══════════════════════════════════════════════════════════════════════
#  점검 체크리스트
# ═══════════════════════════════════════════════════════════════════════
#
#  □ 커밋 전 git status 로 .env / .env.key 스테이징 여부 확인
#  □ 신규 키 추가 시 이 파일에 [S]/[P]·용도·사용처·페이즈를 함께 적는다
#  □ 운영 배포는 deploy/tomcat/conf/pcms.env 로 주입 — setenv 스크립트에
#    값을 직접 박지 않는다
#  □ [S] 키가 로그·오류화면·CSP 리포트에 새지 않는지 확인
#    (SensitiveParamMasker 마스킹 대상에 키 이름을 등록)
#  □ 퇴사·외주 종료·유출 의심 시 [S] 전량 재발급
#
# ═══════════════════════════════════════════════════════════════════════
