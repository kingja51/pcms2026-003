# ============================================================================
#  PCMS 2026-003 — 운영 환경변수 템플릿
# ----------------------------------------------------------------------------
#  설치: 이 파일을 $CATALINA_BASE/conf/pcms.env 로 복사해 값을 채우고
#        chmod 600 (소유자만 읽기). setenv.sh 가 기동 시 로드한다.
#
#  ⚠️ 이 파일에는 **키 이름과 __CHANGE_ME__ 만** 둔다. 실제 값을 절대 넣지 말 것.
#     001 에서는 .env.example 이 .env 의 사본이라 운영 비밀값 21종이 저장소에
#     커밋될 뻔했다. 이 파일은 커밋되고 conf/pcms.env 는 커밋되지 않는다.
#
#  형식: KEY=value  — export 도 따옴표도 쓰지 않는다.
#        값에 & ( ) 같은 특수문자가 있어도 setenv.sh 가 라인 단위로 읽어
#        그대로 export 하므로 이스케이프가 필요 없다(source 는 & 에서 깨진다).
# ============================================================================

# ────────────────────────────────────────────────────────────────────────────
#  1. 필수 — 미주입 시 부팅이 실패한다(fail-fast, 의도된 동작)
#     RequiredPropertyValidator 가 기동 전에 검사하고 누락 키를 전부 나열한다.
# ────────────────────────────────────────────────────────────────────────────

# ── 3-DB (MariaDB) ──────────────────────────────────────────────────────────
PCMS_DB_PRIMARY_URL=__CHANGE_ME__
PCMS_DB_PRIMARY_USER=__CHANGE_ME__
PCMS_DB_PRIMARY_PASSWORD=__CHANGE_ME__
PCMS_DB_SECONDARY_URL=__CHANGE_ME__
PCMS_DB_SECONDARY_USER=__CHANGE_ME__
PCMS_DB_SECONDARY_PASSWORD=__CHANGE_ME__
PCMS_DB_LOGGING_URL=__CHANGE_ME__
PCMS_DB_LOGGING_USER=__CHANGE_ME__
PCMS_DB_LOGGING_PASSWORD=__CHANGE_ME__

# ── PII 암호화 ──────────────────────────────────────────────────────────────
#  두 키는 **반드시 서로 다른 값**이어야 한다(D11). 한 쪽이 유출돼도 다른 쪽이
#  버티도록 AES 마스터키와 HMAC 키를 분리했다.
#  생성: openssl rand -base64 32     (디코드 시 정확히 32바이트여야 한다)
PCMS_PII_MASTER_KEY=__CHANGE_ME__
PCMS_PII_HMAC_KEY=__CHANGE_ME__

# ── 설정 암호화(Jasypt) ─────────────────────────────────────────────────────
JASYPT_ENCRYPTOR_PASSWORD=__CHANGE_ME__

# ── 메일(SMTP) ──────────────────────────────────────────────────────────────
PCMS_MAIL_USERNAME=__CHANGE_ME__
GMAIL_SMTP_USER_PASSWD=__CHANGE_ME__

# ── 정적 자원 루트 ──────────────────────────────────────────────────────────
#  war 밖에 두는 업로드·템플릿 정적 파일의 기준 경로.
PCMS_STATIC_ROOT=__CHANGE_ME__

# ────────────────────────────────────────────────────────────────────────────
#  2. 선택 — 미설정 시 yml 기본값이 쓰인다.
#     아래는 **운영에서 실제로 채워야 하는 것**만 추렸다. 나머지 기본값은
#     application.yml 주석을 볼 것.
# ────────────────────────────────────────────────────────────────────────────

# ── 파일 저장 경로 (기본값은 개발용 경로다 — 운영은 반드시 지정) ────────────
PCMS_UPLOAD_ROOT=__CHANGE_ME__
PCMS_QUARANTINE=__CHANGE_ME__
PCMS_THUMBNAIL=__CHANGE_ME__
PCMS_PREVIEW_CACHE=__CHANGE_ME__
PCMS_CONTENT_HTML_ROOT=__CHANGE_ME__

# ── 프로젝트 표기 ───────────────────────────────────────────────────────────
PCMS_PROJECT_NAME_KO=__CHANGE_ME__
PCMS_PROJECT_NAME_EN=__CHANGE_ME__

# ── 신뢰 프록시 (CIDR CSV) ──────────────────────────────────────────────────
#  리버스 프록시 뒤에 둔다면 반드시 지정. 비우면 X-Forwarded-For 를 신뢰하지
#  않으므로 접속 로그·레이트리밋의 client IP 가 전부 프록시 IP 가 된다.
PCMS_TRUSTED_PROXIES=__CHANGE_ME__

# ── NICE 본인인증 ───────────────────────────────────────────────────────────
#  ⚠️ setenv 의 JPMS 플래그가 함께 있어야 동작한다. 누락 시 본인인증에서만 500.
PCMS_NICE_SITE_CODE=__CHANGE_ME__
PCMS_NICE_SITE_PASSWORD=__CHANGE_ME__
PCMS_NICE_RETURN_URL=__CHANGE_ME__
PCMS_NICE_ERROR_URL=__CHANGE_ME__

# ── OAuth2 소셜 로그인 (쓰는 것만 enabled=true) ─────────────────────────────
PCMS_OAUTH2_REDIRECT_BASE_URL=__CHANGE_ME__
PCMS_OAUTH2_NAVER_ENABLED=false
PCMS_OAUTH2_NAVER_CLIENT_ID=__CHANGE_ME__
PCMS_OAUTH2_NAVER_CLIENT_SECRET=__CHANGE_ME__
PCMS_OAUTH2_NAVER_CALLBACK_URL=__CHANGE_ME__
PCMS_OAUTH2_KAKAO_ENABLED=false
PCMS_OAUTH2_KAKAO_CLIENT_ID=__CHANGE_ME__
PCMS_OAUTH2_KAKAO_CLIENT_SECRET=__CHANGE_ME__
PCMS_OAUTH2_KAKAO_CALLBACK_URL=__CHANGE_ME__
PCMS_OAUTH2_GOOGLE_ENABLED=false
PCMS_OAUTH2_GOOGLE_CLIENT_ID=__CHANGE_ME__
PCMS_OAUTH2_GOOGLE_CLIENT_SECRET=__CHANGE_ME__
PCMS_OAUTH2_GOOGLE_CALLBACK_URL=__CHANGE_ME__

# ── reCAPTCHA v3 ────────────────────────────────────────────────────────────
PCMS_CAPTCHA_ENABLED=true
PCMS_CAPTCHA_SITE_KEY=__CHANGE_ME__
PCMS_CAPTCHA_SECRET_KEY=__CHANGE_ME__

# ── 지도 API (쓰는 것만) ────────────────────────────────────────────────────
PCMS_KAKAO_MAP_APPKEY=__CHANGE_ME__
PCMS_NAVER_MAP_CLIENT_ID=__CHANGE_ME__
PCMS_GOOGLE_MAP_API_KEY=__CHANGE_ME__

# ── 문서 뷰어(LibreOffice) ──────────────────────────────────────────────────
PCMS_LIBREOFFICE_HOME=__CHANGE_ME__

# ── 장애 알림(Telegram) ─────────────────────────────────────────────────────
PCMS_ALERT_TELEGRAM_ENABLED=false
PCMS_ALERT_TELEGRAM_BOT_TOKEN=__CHANGE_ME__
PCMS_ALERT_TELEGRAM_CHAT_ID=__CHANGE_ME__

# ── Flyway ──────────────────────────────────────────────────────────────────
#  ⚠️ 운영은 application-prod.yml 이 false 로 **고정**한다. 이 변수로 켜지지 않는다.
#     스키마 변경은 DBA 가 Flyway CLI 로 집행한다(D1 ③).
