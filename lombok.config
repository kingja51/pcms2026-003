# Lombok 프로젝트 설정 — 루트 1파일로 전 모듈 일괄 적용.
#
# Spring 의 @Qualifier 를 Lombok 생성자 파라미터로 자동 복사.
# 기본값은 미복사 — @RequiredArgsConstructor + 필드 @Qualifier 조합 사용 시,
# 생성된 생성자 파라미터에 @Qualifier 가 없어 by-type 다중 후보 충돌이 발생한다.
# (2026-05-10 WeatherServiceImpl + RestClient 빈 3개 충돌 사례)
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value

# 본 파일을 상위 디렉터리로 더 이상 거슬러 올라가 탐색하지 않음.
config.stopBubbling = true
