# ── 비밀값 (절대 커밋 금지) ────────────────────────────────
.env
.env.*
# 템플릿·인벤토리는 값이 없으므로 추적한다 (실제 값 기입 금지)
!.env.example
!.env.key.example
deploy/tomcat/pcms.env
**/pcms.env

# ── 로컬 계정·자격증명 메모 (절대 커밋 금지) ──────────────────
# 저장소가 public 이다. 테스트 계정 비밀번호도 커밋하지 않는다.
doc/테스트 계정.txt
doc/*계정*.txt
**/*credential*
**/*password*.txt

# ── 빌드 산출물 ────────────────────────────────────────────
target/
build/
out/
*.war
*.jar
!lib/*.jar
*.class

# ── Maven ─────────────────────────────────────────────────
.mvn/wrapper/maven-wrapper.jar
dependency-reduced-pom.xml

# ── npm / Tailwind ────────────────────────────────────────
node_modules/
npm-debug.log*
# Tailwind CLI 산출물 (생성물이므로 커밋하지 않는다)
src/main/resources/static/css/output.css
src/main/resources/static/css/output.css.map
# esbuild 에디터 번들 (생성물 — 원본은 src/editor/)
src/main/resources/static/js/editor/

# ── IDE ───────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.factorypath

# ── 로컬 도구 설정 ─────────────────────────────────────────
.claude/settings.local.json

# ── 런타임 데이터 (업로드·로그) ────────────────────────────
logs/
data/
uploads/
files/

# ── OS ────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
